{
  "format": 2,
  "name": "rhyven/workflow-evaluator",
  "display_name": "Workflow Evaluator",
  "version": "0.1.0",
  "publisher": "rhyven",
  "description": "Compare tool results against immutable project fixtures; catch regressions and retain evaluation history. Python standard library; no Docker.",
  "hosting": {
    "mode": "local"
  },
  "permissions": [
    "state.read",
    "state.write",
    "host.execute"
