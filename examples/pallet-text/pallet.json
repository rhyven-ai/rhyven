{
  "format": "rhyven.pallet/1",
  "name": "example/text-kit",
  "version": "0.1.0",
  "description": "Reusable text normalization, adapters and document preparation.",
  "language": "python",
  "license": "Apache-2.0",
  "files": [
    "textkit.py",
    "LICENSE"
  ],
  "exports": {
    "normalize": {
      "kind": "brick",
      "description": "Normalize repeated whitespace in text",
      "file": "textkit.py",
      "symbol": "normalize",
      "input": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 1000
          }
        },
        "required": [
          "text"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 1000
          }
        },
        "required": [
          "text"
        ],
        "additionalProperties": false
      }
    },
    "slug": {
      "kind": "brick",
      "description": "Convert text to a lowercase URL slug",
      "file": "textkit.py",
      "symbol": "slug",
      "input": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 1000
          }
        },
        "required": [
          "text"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "maxLength": 1000
          }
        },
        "required": [
          "slug"
        ],
        "additionalProperties": false
      }
    },
    "rename_title": {
      "kind": "mortar",
      "description": "Adapt a title field to a text field",
      "file": "textkit.py",
      "symbol": "rename_title",
      "input": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 1000
          }
        },
        "required": [
          "title"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 1000
          }
        },
        "required": [
          "text"
        ],
        "additionalProperties": false
      }
    },
    "prepare_document": {
      "kind": "stack",
      "description": "Normalize document title and derive its URL slug",
      "file": "textkit.py",
      "symbol": "prepare_document",
      "input": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 1000
          }
        },
        "required": [
          "title"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 1000
          },
          "slug": {
            "type": "string",
            "maxLength": 1000
          }
        },
        "required": [
          "title",
          "slug"
        ],
        "additionalProperties": false
      }
    }
  },
  "tests": [
    {
      "export": "normalize",
      "args": {
        "text": " Hello   world "
      },
      "expect": {
        "text": "Hello world"
      }
    },
    {
      "export": "slug",
      "args": {
        "text": "Hello, WORLD!"
      },
      "expect": {
        "slug": "hello-world"
      }
    },
    {
      "export": "rename_title",
      "args": {
        "title": "Notes"
      },
      "expect": {
        "text": "Notes"
      }
    },
    {
      "export": "prepare_document",
      "args": {
        "title": "  Release   Notes! "
      },
      "expect": {
        "title": "Release Notes!",
        "slug": "release-notes"
      }
    }
  ],
  "dependencies": []
}
