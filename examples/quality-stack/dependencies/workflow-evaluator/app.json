  "objects": {},
  "actions": {
    "save_suite": {
      "description": "Save an immutable fixture suite with expected pass/fail outcomes; returns suite_hash and per-case snapshot hashes.",
      "input": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1
          },
          "version": {
            "type": "string",
            "maxLength": 40,
            "minLength": 1
          },
          "cases": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "maxLength": 80,
                  "minLength": 1
                },
                "files": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "path": {
                        "type": "string",
                        "maxLength": 200,
                        "minLength": 1
                      },
                      "content": {
                        "type": "string",
                        "maxLength": 200000
                      }
                    },
                    "required": [
                      "path",
                      "content"
                    ],
                    "additionalProperties": false
                  },
                  "maxItems": 100
                },
                "expected_pass": {
                  "type": "boolean"
                }
              },
              "required": [
                "id",
                "files",
                "expected_pass"
              ],
              "additionalProperties": false
            },
            "maxItems": 30
          }
        },
        "required": [
          "name",
          "version",
          "cases"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 80
          },
          "version": {
            "type": "string",
            "maxLength": 40
          },
          "cases": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
