        "required": [
          "repository",
          "revision",
          "files",
          "total_files",
          "total_bytes",
          "languages",
          "readmes",
          "configs",
          "tree",
          "truncated"
        ],
        "additionalProperties": false
      }
    },
    "scan": {
      "description": "Scan a page of source files; select matching LSPs, persist structur.json, and return next_offset. Repeat until -1. Missing engines/coverage are explicit.",
      "input": {
        "type": "object",
        "properties": {
          "repository": {
            "type": "string",
            "maxLength": 64
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000000
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          },
          "relationships": {
            "type": "boolean"
          }
        },
        "required": [
          "repository"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "revision": {
            "type": "string",
            "maxLength": 64
          },
          "files_scanned": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000000
          },
          "symbols": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000000
          },
          "complete": {
            "type": "boolean"
          },
          "issues": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 2000
            },
            "maxItems": 100
          },
          "next_offset": {
            "type": "integer",
            "minimum": -1,
            "maximum": 100000000
          },
          "artifact": {
            "type": "string",
            "maxLength": 500
          }
        },
        "required": [
          "revision",
          "files_scanned",
          "symbols",
          "complete",
          "issues",
          "next_offset",
          "artifact"
        ],
        "additionalProperties": false
      }
    },
