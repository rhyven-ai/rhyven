  "guide": "Create a fixed suite with action_save_suite. The CALLING AGENT reads its cases, runs each through rhyven/preflight-checker action_run with one policy_hash, then submits full reports to action_evaluate as {case_id,report}. Evaluate baseline and candidate on the identical suite_hash and use action_compare. Missing/duplicate/unknown cases, input mismatches and mixed policy hashes are rejected. Never remove failing cases to claim improvement. Suite name/version and content hash are immutable; add cases as a new suite version, then rerun BOTH policies. Evaluation measures expected pass/fail accuracy, not general agent intelligence. Reports and timings are caller-supplied, not signed attestations; this app does not launch arbitrary commands, models, or MCP clients. Check time excludes process startup, transport/model time, and a single run is not a speed benchmark. Persisted SQLite state is collection/app-local. Python 3.10+, no pip or Docker. host.execute is unsandboxed; request human installation approval. Avoid secrets in stored fixture text.",
  "tests": [
    {
      "operation": "execute",
      "args": {
        "action": "save_suite",
        "args": {
          "name": "smoke",
          "version": "1",
          "cases": [
            {
              "id": "good",
              "files": [
                {
                  "path": "a.txt",
                  "content": "hello"
                }
              ],
              "expected_pass": true
            }
          ]
        }
      },
      "expect": {
        "version": "1"
      }
    },
    {
      "operation": "execute",
      "args": {
        "action": "get_suite",
        "args": {
          "suite_hash": {
            "$result": "0.suite_hash"
          }
        }
      },
      "expect": {
        "name": "smoke"
      }
    },
    {
      "operation": "execute",
      "args": {
        "action": "list_evaluations",
        "args": {}
      },
      "expect": {
        "items": []
      }
    },
    {
      "operation": "execute",
      "args": {
        "action": "evaluate",
        "args": {
          "suite_hash": {
            "$result": "0.suite_hash"
          },
          "observations": [
            {
              "case_id": "good",
              "report": {
                "run_id": "smoke-False",
                "policy_hash": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
                "snapshot_hash": "23a2f6824cb3d542f149ea4999ad00026b7fcf980a22443a1089f7e952db2942",
                "passed": false,
                "duration_ms": 0.1
              }
            }
          ]
        }
      },
      "expect": {
        "correct": 0,
        "total": 1
      }
    },
    {
      "operation": "execute",
      "args": {
        "action": "evaluate",
        "args": {
          "suite_hash": {
            "$result": "0.suite_hash"
          },
          "observations": [
            {
              "case_id": "good",
              "report": {
                "run_id": "smoke-True",
                "policy_hash": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
                "snapshot_hash": "23a2f6824cb3d542f149ea4999ad00026b7fcf980a22443a1089f7e952db2942",
                "passed": true,
                "duration_ms": 0.1
              }
            }
          ]
        }
      },
      "expect": {
        "correct": 1,
        "total": 1
      }
    },
    {
      "operation": "execute",
      "args": {
        "action": "compare",
        "args": {
          "baseline_id": {
            "$result": "3.evaluation_id"
          },
          "candidate_id": {
            "$result": "4.evaluation_id"
          }
        }
      },
      "expect": {
        "improved_without_regressions": true,
        "regressed_cases": []
      }
    }
  ]
}
